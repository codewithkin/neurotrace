# ---------------------------------------------------------------------------
# Files excluded from the tarball uploaded to EAS Build.
#
# IMPORTANT: eas-cli reads this file from the *git repository root*
# (`git rev-parse --show-toplevel`), NOT from the directory containing
# eas.json. In a monorepo it must live here, at apps/'s parent.
#
# Also note: once this file exists, eas-cli STOPS reading .gitignore
# entirely, so every exclusion has to be repeated here.
# Syntax is .gitignore syntax; patterns are relative to this directory.
# ---------------------------------------------------------------------------

# Git history. eas-cli reads the commit hash locally before uploading, so the
# builder does not need it. Remove this line if a build step ever needs git
# metadata (e.g. a Sentry release derived from the commit).
.git

# Dependencies -- reinstalled from pnpm-lock.yaml on the builder.
node_modules
.pnp
.pnp.*

# Build outputs and caches.
.turbo
.nx
.next
out
dist
build
coverage
.cache
tmp
temp
*.tsbuildinfo
.vercel
.netlify
.wrangler
.alchemy
.open-next
.vinxi
.output
.react-router
.tanstack
.nitro

# Expo / RN local state. Native folders are regenerated by prebuild.
.expo
android
ios
.kotlin
.metro-health-check*
web-build
expo-env.d.ts

# Secrets and local overrides. Build-time values belong in eas.json `env`
# or in EAS environment variables, not in an uploaded .env file.
.env
.env.*
!.env.example
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.dev.vars*

# Local databases.
local.db
local.db-*

# Logs.
logs
.evlog
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS noise.
.vscode
.idea
.DS_Store
*.swp
*.swo
*~

# NOTE: apps/web and packages/ui are deliberately NOT excluded. They are pnpm
# workspace members listed in pnpm-lock.yaml; removing their manifests makes
# `pnpm install --frozen-lockfile` fail on the builder with ERR_PNPM_OUTDATED_LOCKFILE.
# Their source is ~230 KB, so keeping them costs almost nothing.
